@model IEnumerable<Pedido>
@{
    ViewData["Title"] = "Pedidos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Pedidos</h2>
    <a class="btn btn-primary" asp-action="Crear">+ Nuevo pedido</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Cliente</th>
            <th>Registrado por</th>
            <th>Fecha</th>
            <th class="text-end">Total</th>
            <th>Estado</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var pedido in Model)
    {
        <tr>
            <td>@pedido.Id</td>
            <td>@pedido.ClienteNombre</td>
            <td>@pedido.UsuarioNombre</td>
            <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">Q@pedido.Total.ToString("N2")</td>
            <td>
                <span class="badge @(pedido.Estado == "Completado" ? "bg-success" : "bg-secondary")">@pedido.Estado</span>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@pedido.Id">Ver</a>
                @if (User.IsInRole("Administrador") && pedido.Estado == "Completado")
                {
                    <form asp-action="Cancelar" asp-route-id="@pedido.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Cancelar este pedido? El stock será restituido.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
