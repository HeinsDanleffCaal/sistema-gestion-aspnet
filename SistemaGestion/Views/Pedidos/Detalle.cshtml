@model Pedido
@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}
<h2>Pedido #@Model.Id</h2>
<dl class="row">
    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.ClienteNombre</dd>
    <dt class="col-sm-2">Registrado por</dt>
    <dd class="col-sm-10">@Model.UsuarioNombre</dd>
    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">
        <span class="badge @(Model.Estado == "Completado" ? "bg-success" : "bg-secondary")">@Model.Estado</span>
    </dd>
</dl>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-end">Cantidad</th>
            <th class="text-end">Precio unitario</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var linea in Model.Detalles)
    {
        <tr>
            <td>@linea.ProductoNombre</td>
            <td class="text-end">@linea.Cantidad</td>
            <td class="text-end">Q@linea.PrecioUnitario.ToString("N2")</td>
            <td class="text-end">Q@linea.Subtotal.ToString("N2")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end">Q@Model.Total.ToString("N2")</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
