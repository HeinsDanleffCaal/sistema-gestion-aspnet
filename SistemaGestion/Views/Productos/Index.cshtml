@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Productos</h2>
    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-primary" asp-action="Crear">+ Nuevo producto</a>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Stock</th>
            @if (User.IsInRole("Administrador"))
            {
                <th class="text-end">Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var producto in Model)
    {
        <tr>
            <td>@producto.Nombre</td>
            <td>@producto.Descripcion</td>
            <td class="text-end">Q@(producto.Precio.ToString("N2"))</td>
            <td class="text-end">
                @if (producto.Stock <= 5)
                {
                    <span class="badge bg-danger">@producto.Stock</span>
                }
                else
                {
                    @producto.Stock
                }
            </td>
            @if (User.IsInRole("Administrador"))
            {
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@producto.Id">Editar</a>
                    <form asp-action="Eliminar" asp-route-id="@producto.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este producto?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            }
        </tr>
    }
    </tbody>
</table>
