@model UsuarioCrearViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}
<h2>Nuevo usuario</h2>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Crear" method="post" class="row g-3" style="max-width: 600px;">
    <div class="col-6">
        <label asp-for="NombreUsuario" class="form-label"></label>
        <input asp-for="NombreUsuario" class="form-control" required />
        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
    </div>
    <div class="col-6">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" required />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="NombreCompleto" class="form-label"></label>
        <input asp-for="NombreCompleto" class="form-control" required />
    </div>
    <div class="col-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" required />
    </div>
    <div class="col-6">
        <label asp-for="RolId" class="form-label"></label>
        <select asp-for="RolId" class="form-select">
            <option value="1">Administrador</option>
            <option value="2">Usuario</option>
        </select>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
